# SeedInfer Worker — Environment Configuration Example
# Copy to .env for local development. Never commit real credentials or .env files.

WORKER_PORT=3001
WORKER_ID=worker-node-placeholder-01
WORKER_REGION=eu-central
WORKER_LOG_LEVEL=info

# --- Router Gateway & Heartbeat ---
SEEDINFER_GATEWAY_URL=https://seedinfer.com
SEEDINFER_NODE_TOKEN=sipn_placeholder_0000000000000000000000000000000
HEARTBEAT_INTERVAL=30
HEARTBEAT_BACKOFF_BASE_SEC=1.0
HEARTBEAT_BACKOFF_MAX_SEC=60.0

# --- Inference Engine Adapter (vllm | llamacpp | mock) ---
ENGINE_BACKEND=mock
ENGINE_URL=http://127.0.0.1:8000
MODEL=qwen-2.5-7b
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- Hardware Telemetry & Capacity Guard ---
SEEDINFER_MOCK_GPU=1
MOCK_GPU_NAME=NVIDIA GeForce RTX 4090 (Simulated)
MOCK_GPU_VRAM_TOTAL_MB=24576
MOCK_GPU_VRAM_FREE_MB=18432
MAX_CONCURRENT_REQUESTS=32
MAX_KV_CACHE_TOKENS=1500000
